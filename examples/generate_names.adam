// ============================================================================
// Name Generator — Load pretrained transformer weights and generate names
// ============================================================================
//
// Loads weights saved by transformer.adam and generates new names instantly.
// Run: just generate-names
//
// Requires trained weights in models/ (run `just transformer` first).
// ============================================================================

// ─── Hyperparameters (must match transformer.adam) ──────────────────────────

let vocab_size = 28
let seq_len = 19
let d_model = 96
let d_ff = 384
let scale = 0.1021

// ─── Softmax helper ────────────────────────────────────────────────────────

fn softmax(x) {
    let mx = tensor_max_axis(x, -1)
    let e = tensor_exp(x - mx)
    e / tensor_sum_axis(e, -1)
}

// ─── Character encoding/decoding ─────────────────────────────────────────

fn decode_token(tok) {
    if tok >= 1 {
        if tok <= 26 {
            chr(tok + 96)
        } else {
            "'"
        }
    } else {
        ""
    }
}

// Token values: a=1, b=2, ..., z=26 (matching prepare_names.py encoding)

// ─── Load pretrained weights ───────────────────────────────────────────────

println("Loading pretrained weights...")
let tok_emb = tensor_load("models/transformer_tok_emb.bin")
let pos_emb = tensor_load("models/transformer_pos_emb.bin")
let wq = tensor_load("models/transformer_wq.bin")
let wk = tensor_load("models/transformer_wk.bin")
let wv = tensor_load("models/transformer_wv.bin")
let wo = tensor_load("models/transformer_wo.bin")
let w1 = tensor_load("models/transformer_w1.bin")
let b1 = tensor_load("models/transformer_b1.bin")
let w2 = tensor_load("models/transformer_w2.bin")
let b2 = tensor_load("models/transformer_b2.bin")
let w_out = tensor_load("models/transformer_w_out.bin")
let b_out = tensor_load("models/transformer_b_out.bin")
let mask = tensor_causal_mask(seq_len)
println("Loaded.")

// ─── Generation ────────────────────────────────────────────────────────────

fn generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask, temp, start_token) {
    let seq = tensor_zeros([1, seq_len])
    let name = ""
    let pos = 1
    let done = false

    // If start_token > 0, seed the sequence with that letter
    if start_token > 0 {
        seq = tensor_set(seq, 1, start_token)
        name = decode_token(start_token)
        pos = 2
    } else {
        0
    }

    let inv_temp = if temp > 0.0 { 1.0 / temp } else { 1.0 }

    while pos < seq_len - 1 {
        if done == false {
            let g_emb = tensor_embedding_lookup(tok_emb, seq) + pos_emb
            let g_q = g_emb @@ wq
            let g_k = g_emb @@ wk
            let g_v = g_emb @@ wv
            let g_kt = tensor_permute(g_k, [0, 2, 1])
            let g_attn = softmax((g_q @@ g_kt) * scale + mask)
            let g_h = g_emb + (g_attn @@ g_v) @@ wo
            let g_h2 = g_h + tensor_relu(g_h @@ w1 + b1) @@ w2 + b2
            let g_logits = g_h2 @@ w_out + b_out
            let g_probs = softmax(g_logits * inv_temp)
            let pred = tensor_sample(g_probs, -1)
            let next_token = to_int(tensor_get(pred, pos - 1))

            if next_token == 0 {
                done = true
                0
            } else {
                name = name + decode_token(next_token)
                seq = tensor_set(seq, pos, next_token)
                pos = pos + 1
            }
        } else {
            pos = pos + 1
        }
    }
    name
}

// ─── Section 1: Random names (temp=1.0, no conditioning) ─────────────────

println("")
println("=== Random Names (temperature=1.0) ===")
let gi = 0
while gi < 10 {
    let name = generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask, 1.0, 0)
    println("  " + name)
    gi = gi + 1
}

// ─── Section 2: Temperature comparison ───────────────────────────────────
// Token values: a=1, k=11, m=13, r=18, s=19

println("")
println("=== Temperature Comparison ===")
println("  Letter  temp=0.5 (conservative)   temp=1.0 (normal)       temp=1.5 (creative)")

let temp_tokens = [19, 13, 11, 1, 18]
let temp_labels = ["s", "m", "k", "a", "r"]
let li = 0
while li < 5 {
    let tok = temp_tokens[li]
    let ch = temp_labels[li]
    let n_low  = generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask, 0.5, tok)
    let n_mid  = generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask, 1.0, tok)
    let n_high = generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask, 1.5, tok)
    println("  " + ch + "       " + n_low + "                        " + n_mid + "                        " + n_high)
    li = li + 1
}

// ─── Section 3: Names by letter ──────────────────────────────────────────
// Token values: j=10, k=11, z=26, a=1, m=13

println("")
println("=== Names by Starting Letter ===")
let letter_tokens = [10, 11, 26, 1, 13]
let letter_labels = ["j", "k", "z", "a", "m"]
let li2 = 0
while li2 < 5 {
    let tok2 = letter_tokens[li2]
    let ch2 = letter_labels[li2]
    let n1 = generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask, 1.0, tok2)
    let n2 = generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask, 1.0, tok2)
    let n3 = generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask, 1.0, tok2)
    println("  " + ch2 + ": " + n1 + ", " + n2 + ", " + n3)
    li2 = li2 + 1
}

println("")
println("Done!")
