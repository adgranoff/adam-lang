// ============================================================================
// Name Generator — Load pretrained transformer weights and generate names
// ============================================================================
//
// Loads weights saved by transformer.adam and generates new names instantly.
// Run: just generate-names
//
// Requires trained weights in models/ (run `just transformer` first).
// ============================================================================

// ─── Hyperparameters (must match transformer.adam) ──────────────────────────

let vocab_size = 28
let seq_len = 19
let d_model = 64
let d_ff = 256
let scale = 0.125

// ─── Softmax helper ────────────────────────────────────────────────────────

fn softmax(x) {
    let mx = tensor_max_axis(x, -1)
    let e = tensor_exp(x - mx)
    e / tensor_sum_axis(e, -1)
}

// ─── Decode token to character ─────────────────────────────────────────────

fn decode_token(tok) {
    if tok >= 1 {
        if tok <= 26 {
            chr(tok + 96)
        } else {
            "'"
        }
    } else {
        ""
    }
}

// ─── Load pretrained weights ───────────────────────────────────────────────

println("Loading pretrained weights...")
let tok_emb = tensor_load("models/transformer_tok_emb.bin")
let pos_emb = tensor_load("models/transformer_pos_emb.bin")
let wq = tensor_load("models/transformer_wq.bin")
let wk = tensor_load("models/transformer_wk.bin")
let wv = tensor_load("models/transformer_wv.bin")
let wo = tensor_load("models/transformer_wo.bin")
let w1 = tensor_load("models/transformer_w1.bin")
let b1 = tensor_load("models/transformer_b1.bin")
let w2 = tensor_load("models/transformer_w2.bin")
let b2 = tensor_load("models/transformer_b2.bin")
let w_out = tensor_load("models/transformer_w_out.bin")
let b_out = tensor_load("models/transformer_b_out.bin")
let mask = tensor_causal_mask(seq_len)
println("Loaded.")

// ─── Generation ────────────────────────────────────────────────────────────

fn generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask) {
    let seq = tensor_zeros([1, seq_len])
    let name = ""
    let pos = 1
    let done = false

    while pos < seq_len - 1 {
        if done == false {
            let g_emb = tensor_embedding_lookup(tok_emb, seq) + pos_emb
            let g_q = g_emb @@ wq
            let g_k = g_emb @@ wk
            let g_v = g_emb @@ wv
            let g_kt = tensor_permute(g_k, [0, 2, 1])
            let g_attn = softmax((g_q @@ g_kt) * scale + mask)
            let g_h = g_emb + (g_attn @@ g_v) @@ wo
            let g_h2 = g_h + tensor_relu(g_h @@ w1 + b1) @@ w2 + b2
            let g_logits = g_h2 @@ w_out + b_out
            let g_probs = softmax(g_logits)
            let pred = tensor_sample(g_probs, -1)
            let next_token = to_int(tensor_get(pred, pos - 1))

            if next_token == 0 {
                done = true
                0
            } else {
                name = name + decode_token(next_token)
                seq = tensor_set(seq, pos, next_token)
                pos = pos + 1
            }
        } else {
            pos = pos + 1
        }
    }
    name
}

println("")
println("Generated names:")
let gi = 0
while gi < 20 {
    let name = generate_name(tok_emb, pos_emb, wq, wk, wv, wo, w1, b1, w2, b2, w_out, b_out, mask)
    println("  " + name)
    gi = gi + 1
}
println("Done!")
